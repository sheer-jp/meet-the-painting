# worktree では node_modules が symlink のことがあるので、末尾の / を付けない
node_modules
dist/
.env
.env.*
.DS_Store
*.log
# 生成物（流れ場・部屋の合成・訳・QR）は works/<id>/generated/ に出る。1 作品 10MB 程度までコミットしてよい
# 声の原本（wav）はコミットしない
*.wav
works/*/generated/*.tmp
# ビルドの中間物
.vite/
# 生成物の HTML（ルートの受付、ギャラリー、作品ページ）だけを無視する。public/admin/index.html などの手書きの HTML は追跡する
/w/*/index.html
/index.html
/gallery/index.html
# Cloudflare Pages Functions（気分から絵をすすめる。functions/）。wrangler の作業フォルダと手元の Secret
.wrangler/
.dev.vars

# 提出用のデモ動画は git に入れず、配置のときに dist/demo/demo.mp4 へ置く
public/demo/*.mp4
