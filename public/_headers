# Cloudflare Pages のヘッダ（11-07 深夜）。キャラクターのコマと生成物は長く cache（名前が変われば URL も変わる前提。コマは差し替えたら名前を変えるか、1 日で切れる）
/concierge/*
  Cache-Control: public, max-age=86400
/works/*
  Cache-Control: public, max-age=86400
/rooms/*
  Cache-Control: public, max-age=86400
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/api/*
  Cache-Control: no-store
# 管理ページ（docs/ADMIN.md 4 節）：noindex、作家専用。Google のログインのボタンだけ外から読む
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
